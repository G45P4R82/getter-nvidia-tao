#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="${ROOT_DIR}/.runtime/tao-docker-compose"
UPSTREAM_REPO="${UPSTREAM_REPO:-https://github.com/NVIDIA-TAO/tao-tutorials.git}"
UPSTREAM_REF="${UPSTREAM_REF:-main}"
CONFIG_FILE="${ROOT_DIR}/config.env"
SECRETS_FILE="${ROOT_DIR}/secrets.json"

usage() {
  printf '%s\n' \
    'Usage: ./tao-ftms COMMAND [OPTIONS]' \
    '' \
    'Commands:' \
    '  up, up-all, down, restart, logs, status, config' \
    '' \
    'Options:' \
    '  --airgapped, --no-airgapped, --ptm, --no-ptm' \
    '  --python=VERSION, --upstream-ref=REF'
}

require_file() {
  if [[ ! -f "$1" ]]; then
    printf 'Missing %s. Copy the example file first.\n' "$1" >&2
    exit 1
  fi
}

prepare_runtime() {
  require_file "$CONFIG_FILE"
  require_file "$SECRETS_FILE"
  mkdir -p "$RUNTIME_DIR"

  if [[ ! -d "$RUNTIME_DIR/.git" ]]; then
    git clone --filter=blob:none --no-checkout "$UPSTREAM_REPO" "$RUNTIME_DIR"
  fi

  git -C "$RUNTIME_DIR" fetch --depth=1 origin "$UPSTREAM_REF"
  git -C "$RUNTIME_DIR" checkout --force FETCH_HEAD

  local upstream_dir="$RUNTIME_DIR/setup/tao-docker-compose"
  if [[ ! -f "$upstream_dir/docker-compose.yml" || ! -f "$upstream_dir/run.sh" ]]; then
    printf 'Upstream FTMS Compose bundle is incomplete at ref %s.\n' "$UPSTREAM_REF" >&2
    exit 1
  fi

  cp "$CONFIG_FILE" "$upstream_dir/config.env"
  cp "$SECRETS_FILE" "$upstream_dir/secrets.json"
  chmod 600 "$upstream_dir/secrets.json"

  # MongoDB latest currently refuses to start on the host's kernel 7.x.
  # Keep the official Compose bundle intact in Git and pin its local runtime
  # override to a MongoDB line compatible with this host.
  python3 - "$upstream_dir/docker-compose.yml" <<'PY'
from pathlib import Path
import sys

compose_file = Path(sys.argv[1])
content = compose_file.read_text()
content = content.replace(
    "image: mongo:latest",
    "image: ${MONGODB_IMAGE:-mongo:7.0}",
    1,
)
compose_file.write_text(content)
PY

  # The upstream auth hook is attached to the auth blueprint only. Use the
  # bundled NGINX as the perimeter so every API blueprint requires a JWT.
  python3 - "$upstream_dir/nginx_sites/default.conf" <<'PY'
from pathlib import Path
import sys

nginx_file = Path(sys.argv[1])
content = nginx_file.read_text()
auth_block = r'''    # Reject encoded and plain traversal attempts before proxying.
    if ($request_uri ~* "(\\.\\.|%2e%2e|%2f|%5c)") { return 400; }

    # Internal auth subrequest. The application validates the JWT and NGC
    # session; the client never reaches this location directly.
    location = /_tao_auth {
        internal;
        proxy_pass http://tao_api_app:8000/api/v2/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-Url $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header Host $host;
    }

    location = /api/v2/login {
        proxy_pass http://tao_api_app:8000/api/v2/login;
        proxy_pass_request_headers on;
    }

    location = /api/v2/health {
        proxy_pass http://tao_api_app:8000/api/v2/health;
        proxy_pass_request_headers on;
    }

    location = /api/v2/redoc {
        proxy_pass http://tao_api_app:8000/api/v2/redoc;
        proxy_pass_request_headers on;
    }

    location = /api/v2/openapi.json {
        proxy_pass http://tao_api_app:8000/api/v2/openapi.json;
        proxy_pass_request_headers on;
    }

'''
needle = "    location /api/ {\n"
if needle not in content:
    raise SystemExit("TAO NGINX API location was not found")
content = content.replace(needle, auth_block + "    location /api/ {\n", 1)
api_start = content.index("    location /api/ {\n")
api_end = content.index("    }\n", api_start)
api_block = content[api_start:api_end]
api_block = api_block.replace(
    "        proxy_pass_request_headers on;\n",
    "        auth_request /_tao_auth;\n        proxy_pass_request_headers on;\n",
    1,
)
content = content[:api_start] + api_block + content[api_end:]
nginx_file.write_text(content)
PY

  python3 - "$upstream_dir/docker-compose.yml" <<'PY'
from pathlib import Path
import sys

compose_file = Path(sys.argv[1])
content = compose_file.read_text()
needle = "      USE_ADMIN_KEY: ${USE_ADMIN_KEY:-True}"
replacement = needle + "\n      INGRESSENABLED: ${INGRESSENABLED:-true}"
if needle not in content:
    raise SystemExit("TAO USE_ADMIN_KEY environment entry was not found")
content = content.replace(needle, replacement)
compose_file.write_text(content)
PY
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi

  prepare_runtime
  local command="$1"
  shift

  case "$command" in
    --help|-h|help)
      usage
      ;;
    up|up-all|down|restart|logs|status|config|cleanup-seaweed|clear-mongo)
      cd "$RUNTIME_DIR/setup/tao-docker-compose"
      exec ./run.sh "$command" "$@"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
